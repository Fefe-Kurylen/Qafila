# Qafila Browser — publication App Store.
#   fastlane ios build   : compile sans signature (vérification)
#   fastlane ios beta    : archive signée + envoi TestFlight
#   fastlane ios release : envoi sur App Store Connect + soumission à la validation
default_platform(:ios)

platform :ios do
  before_all do
    # L'identifiant d'équipe Apple (secret APPLE_TEAM_ID) est injecté dans le projet généré.
    ENV["QAFILA_TEAM_ID"] ||= ENV["APPLE_TEAM_ID"]
    sh("cd .. && xcodegen generate")
  end

  desc "Compilation de vérification (appareil iOS, sans signature)"
  lane :build do
    xcodebuild(scheme: "QafilaBrowser", project: "QafilaBrowser.xcodeproj", destination: "generic/platform=iOS", xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO build")
  end

  desc "Clé API App Store Connect (secrets CI) : contenu du .p8 collé tel quel ou encodé en base64"
  private_lane :api_key do
    content = ENV["APP_STORE_CONNECT_KEY_CONTENT"].to_s.strip
    raw = content.include?("BEGIN PRIVATE KEY") ? content : Base64.decode64(content)
    # Fichier .p8 pour xcodebuild (signature gérée par Apple, sans Mac ni certificat à exporter).
    @key_path = "/tmp/AuthKey_#{ENV['APP_STORE_CONNECT_KEY_ID']}.p8"
    File.write(@key_path, raw)
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: raw,
      is_key_content_base64: false,
      in_house: false
    )
  end

  desc "Build signé + TestFlight"
  lane :beta do
    api_key
    setup_ci if ENV["CI"]
    # Option 1 (recommandée, sans Mac) : signature automatique, certificat de distribution géré dans le cloud par Apple
    #   grâce à la clé API (rôle Admin). Option 2 : certificat .p12 fourni dans les secrets.
    if ENV["IOS_CERT_P12_BASE64"].to_s != ""
      File.write("/tmp/cert.p12", Base64.decode64(ENV["IOS_CERT_P12_BASE64"]))
      import_certificate(certificate_path: "/tmp/cert.p12", certificate_password: ENV["IOS_CERT_PASSWORD"], keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "login.keychain-db", keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "")
      get_provisioning_profile(app_identifier: "fr.qafila.QafilaBrowser", api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY])
    end
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{@key_path} -authenticationKeyID #{ENV['APP_STORE_CONNECT_KEY_ID']} -authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID']}"
    increment_build_number(build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"), xcodeproj: "QafilaBrowser.xcodeproj")
    build_app(
      scheme: "QafilaBrowser", project: "QafilaBrowser.xcodeproj", export_method: "app-store",
      xcargs: auth, export_xcargs: auth,
      export_options: { signingStyle: "automatic", teamID: ENV["APPLE_TEAM_ID"], manageAppVersionAndBuildNumber: false }
    )
    upload_to_testflight(api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY], skip_waiting_for_build_processing: true, changelog: "Qafila Browser — build automatique")
  end

  desc "Envoi App Store Connect avec métadonnées et soumission"
  lane :release do
    beta
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_binary_upload: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false }
    )
  end
end
