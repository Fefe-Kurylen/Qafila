{
  "url": "https://account.example/security",
  "description": "Changement de mot de passe : actuel + nouveau + confirmation, sans identifiant.",
  "detect": [
    {
      "origin": "https://account.example",
      "formActionOrigin": "https://account.example",
      "form": "#pwd-change",
      "isSignup": false,
      "isPasswordChange": true,
      "fields": [
        { "kind": "password", "selectorPath": "#pwd-change > label:nth-of-type(1) > input:nth-of-type(1)", "visible": true, "autocomplete": "current-password" },
        { "kind": "newPassword", "selectorPath": "#pwd-change > label:nth-of-type(2) > input:nth-of-type(1)", "visible": true, "autocomplete": "new-password" },
        { "kind": "confirmPassword", "selectorPath": "#pwd-change > label:nth-of-type(3) > input:nth-of-type(1)", "visible": true, "autocomplete": "new-password" }
      ]
    }
  ]
}
