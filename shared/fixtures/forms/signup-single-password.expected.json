{
  "url": "https://club.example/inscription",
  "description": "Inscription à un seul mot de passe, sans autocomplete : l'action « /inscription » et le bouton « Créer mon compte » suffisent ; l'e-mail l'emporte sur le pseudo.",
  "detect": [
    {
      "origin": "https://club.example",
      "formActionOrigin": "https://club.example",
      "form": "#join",
      "isSignup": true,
      "isPasswordChange": false,
      "fields": [
        { "kind": "username", "selectorPath": "#mail", "visible": true, "autocomplete": null },
        { "kind": "newPassword", "selectorPath": "#mdp", "visible": true, "autocomplete": null }
      ]
    }
  ]
}
