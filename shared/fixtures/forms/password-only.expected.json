{
  "url": "https://intranet.example/zone",
  "description": "Mot de passe seul, sans identifiant ; chemin sans id (nth-of-type depuis le formulaire).",
  "detect": [
    {
      "origin": "https://intranet.example",
      "formActionOrigin": "https://intranet.example",
      "form": "#gate",
      "isSignup": false,
      "isPasswordChange": false,
      "fields": [
        { "kind": "password", "selectorPath": "#gate > label:nth-of-type(1) > input:nth-of-type(1)", "visible": true, "autocomplete": null }
      ]
    }
  ]
}
